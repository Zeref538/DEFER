# Copy to .env and fill in. Never commit .env.
#
# Hugging Face access token. Required because Llama-3.2-3B-Instruct is a gated
# model: you must accept Meta's licence on the model page with this account
# before the token will download the weights.
# Create one at https://huggingface.co/settings/tokens  (scope: read)
# On Kaggle this goes in Add-ons > Secrets under the name HF_TOKEN, not here.
HF_TOKEN=

# Same token with write scope, used only by the publish step that pushes the
# trained adapter to Zeref538/Llama-3.2-3B-DEFER.
HF_TOKEN_WRITE=
